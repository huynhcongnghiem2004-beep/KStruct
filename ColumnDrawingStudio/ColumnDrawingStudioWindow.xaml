<Window x:Class="ColumnRebarPro.V3.ColumnDrawingStudioWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KStruct | Column Drawing Studio V2.0.5.1" Height="760" Width="1100"
        MinWidth="950" MinHeight="620" WindowStartupLocation="CenterOwner"
        Background="#F4F4F4" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1D344B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,5"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#91C0CD" Padding="18,12">
      <StackPanel>
        <TextBlock Text="KSTRUCT  /  COLUMN DRAWING STUDIO" Foreground="#203B5C" FontSize="14" FontWeight="Bold"/>
        <TextBlock Text="Triển khai hồ sơ cột từ thép KStruct V3/V4 hiện có · Revit 2024"
                   Foreground="#203B5C" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE5ED" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="StatusText" Text="Kiểm tra lựa chọn và thiết lập trước khi tạo bản vẽ." FontWeight="SemiBold"/>
          <TextBlock Text="Chỉ thay đổi mô hình sau khi xác nhận và chạy lệnh. Bản vẽ tạo ra là DRAFT." FontSize="11" Foreground="#667B90"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Close" Width="95" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="RunButton" Content="Run" Width="170" IsDefault="True"
                  Background="#237C9A" Foreground="White" FontWeight="SemiBold" Click="Run_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Margin="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="51*"/><ColumnDefinition Width="49*"/></Grid.ColumnDefinitions>
      <GroupBox Grid.Column="0" Header="01  LONGITUDINAL SECTION · Mặt cắt dọc" Background="White" Margin="0,0,6,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel x:Name="LongOptions"><TextBlock x:Name="LongSummary" Visibility="Collapsed"/></StackPanel>
          <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas x:Name="LongCanvas" Width="310" Height="400" ClipToBounds="True"/></Viewbox>
          <TextBlock Grid.Row="2" Text="Hình chiếu đường tâm thép · Không dùng để gia công" TextWrapping="Wrap" FontSize="11" Foreground="#80604A"/>
        </Grid>
      </GroupBox>
      <Grid Grid.Column="1" Margin="6,0,0,0">
        <Grid.RowDefinitions><RowDefinition Height="55*"/><RowDefinition Height="45*"/></Grid.RowDefinitions>
        <GroupBox Header="02  CROSS SECTION · Mặt cắt ngang" Background="White" Margin="0,0,0,6">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="65*"/><ColumnDefinition Width="35*"/></Grid.ColumnDefinitions><StackPanel x:Name="CrossOptions" Grid.ColumnSpan="2"/>
            <Viewbox Grid.Row="1" Stretch="Uniform"><Canvas x:Name="CrossCanvas" Width="245" Height="320" ClipToBounds="True"/></Viewbox>
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="8,0,0,0">
                <TextBlock x:Name="CrossSummary" Visibility="Collapsed"/>
                <TextBlock Text="Cột xem trước" FontWeight="SemiBold"/>
                <ComboBox x:Name="ColumnPicker" MinHeight="28" Margin="0,4,0,8"/>
                <TextBlock Text="Cao độ mặt cắt" FontWeight="SemiBold"/>
                <ComboBox x:Name="CutPicker" SelectedIndex="1" MinHeight="28" Margin="0,4,0,8"><ComboBoxItem Content="Chân cột"/><ComboBoxItem Content="Giữa cột"/><ComboBoxItem Content="Đầu cột"/></ComboBox>
                <TextBlock x:Name="ModelSummary" TextWrapping="Wrap" FontSize="11"/>
                <Button Content="Xuất chẩn đoán JSON" Click="Export_Click" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="03  OTHER SETTINGS · Thiết lập bản vẽ" Background="White" Margin="0,6,0,0">
          <DockPanel>
            <TextBlock x:Name="SheetSummary" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button DockPanel.Dock="Bottom" Content="Mở cấu hình đầy đủ" Click="Settings_Click" Margin="0,8,0,0"/>
            <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="OtherOptions"/></ScrollViewer>
          </DockPanel>
        </GroupBox>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
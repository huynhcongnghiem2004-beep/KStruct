<Window x:Class="ColumnRebarPro.V3.ColumnDrawingStudioWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KStruct | Column Drawing Studio V2.0" Height="800" Width="1280"
        MinWidth="1050" MinHeight="640" WindowStartupLocation="CenterOwner"
        Background="#F2F6FA" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1D344B"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
    <Style TargetType="GroupBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="12"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="14,5"/>
    </Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#193B57" Padding="18,12">
      <StackPanel>
        <TextBlock Text="KSTRUCT  /  COLUMN DRAWING STUDIO" Foreground="White" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Triển khai hồ sơ cột từ thép KStruct V3/V4 hiện có · Revit 2024"
                   Foreground="#C9E8F4" FontSize="12" Margin="0,4,0,0"/>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DCE5ED" BorderThickness="0,1,0,0" Padding="14,10">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="StatusText" Text="Kiểm tra lựa chọn và thiết lập trước khi tạo bản vẽ." FontWeight="SemiBold"/>
          <TextBlock Text="Chỉ thay đổi mô hình sau khi xác nhận và chạy lệnh. Bản vẽ tạo ra là DRAFT." FontSize="11" Foreground="#667B90"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Đóng" Width="95" IsCancel="True" Margin="0,0,8,0"/>
          <Button x:Name="RunButton" Content="Tạo bộ bản vẽ" Width="170" IsDefault="True"
                  Background="#237C9A" Foreground="White" FontWeight="SemiBold" Click="Run_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="48*" MinWidth="480"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#DCE5ED" BorderThickness="1" CornerRadius="5" Margin="0,0,12,0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#A9D3DD" Padding="12,8">
            <TextBlock Text="Cấu hình bản vẽ &amp; tài nguyên Revit" FontWeight="Bold"/>
          </Border>
          <TabControl>
            <TabItem Header="Cấu hình chi tiết">
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ContentControl x:Name="SettingsHost" MinWidth="780"/></ScrollViewer>
            </TabItem>
            <TabItem Header="Hướng dẫn">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                  <TextBlock Text="Quy trình" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                  <TextBlock Text="1. Chọn cột kết cấu đã có thép KStruct V3/V4 trong mô hình." TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <TextBlock Text="2. Chọn View Type, View Template, Tag, Dimension và Title Block có trong project." TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <TextBlock Text="3. Nhập số và tên Sheet, thiết lập tỷ lệ mặt cắt dọc/ngang." TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <TextBlock Text="4. Chạy để tạo hồ sơ bằng engine bản vẽ KStruct hiện có." TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <TextBlock Text="Chọn cột trước khi mở Studio để xem hình chiếu đường tâm thép từ mô hình."
                             TextWrapping="Wrap" Foreground="#A05C28" FontWeight="SemiBold"/>
                </StackPanel>
              </ScrollViewer>
            </TabItem>
          </TabControl>
        </DockPanel>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58*"/>
            <ColumnDefinition Width="42*"/>
          </Grid.ColumnDefinitions>
          <GroupBox Header="①  MẶT CẮT DỌC · Longitudinal Section" Grid.Column="0" Background="White" Margin="0,0,7,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock x:Name="LongSummary" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"/>
              <Viewbox Grid.Row="1" Stretch="Uniform">
                <Canvas x:Name="LongCanvas" Width="310" Height="400"/>
              </Viewbox>
            </Grid>
          </GroupBox>
          <GroupBox Header="②  MẶT CẮT NGANG · Cross Section" Grid.Column="1" Background="White" Margin="7,0,0,0">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TextBlock x:Name="CrossSummary" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11"/>
              <Viewbox Grid.Row="1" Stretch="Uniform">
                <Canvas x:Name="CrossCanvas" Width="245" Height="320"/>
              </Viewbox>
            </Grid>
          </GroupBox>
        </Grid>
        <Border Grid.Row="1" Background="#EAF3F7" BorderBrush="#BFD9E4" BorderThickness="1" Padding="12" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="③  OTHER SETTINGS / BẢN VẼ" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock x:Name="SheetSummary" TextWrapping="Wrap"/><TextBlock x:Name="ModelSummary" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="Xuất chẩn đoán JSON" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Export_Click"/>
            <TextBlock Text="Preview đường tâm từ mô hình, không phải bản vẽ phát hành." Foreground="#9A5A2E" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
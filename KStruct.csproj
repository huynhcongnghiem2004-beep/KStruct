<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- XAML compilation creates InitializeComponent and named WPF controls -->
    <UseWPF>true</UseWPF>
    <AssemblyName>KStruct</AssemblyName>
    <RootNamespace>SDK_HD.KStruct</RootNamespace>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>$(MSBuildProjectDirectory)\bin\$(Configuration)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2024\</RevitInstallDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="PresentationFramework" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression">
      <HintPath>C:\Windows\Microsoft.NET\Framework64\v4.0.30319\System.IO.Compression.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BimSpeedStructureColumnDesignPort\**\*.cs" />
    <Compile Remove="thepmong\BottomLayerTests.cs" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="BimSpeedStructureBeamDesign\**\*.cs" />
    <Page Remove="BimSpeedStructureBeamDesign\**\*.xaml" />
    <EmbeddedResource Remove="BimSpeedStructureBeamDesign\**\*.resx" />
  </ItemGroup>

  <!-- Icon nhúng vào KStruct.dll -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
    <Content Include="Resources\SlabModules\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>



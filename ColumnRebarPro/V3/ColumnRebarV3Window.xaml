                        </Grid>
                    </GroupBox>


                        </Grid>
                    </TabItem>
<TabItem Header="Thép đai">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <GroupBox Grid.Column="0" Grid.Row="0" Header="Quy tắc rải cốt đai chính" Style="{StaticResource PanelGroup}">
                <StackPanel Margin="8">
                    <TextBlock Text="Cấu hình theo vùng đầu và vùng giữa của tầng đang chọn. Bước thực tế không vượt quá bước thiết kế nhập." TextWrapping="Wrap" Foreground="#FF315889" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Chiều dài vùng đai đầu mỗi đầu (mm)"/><TextBox x:Name="ZoneBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Bước đai hai đầu (mm)"/><TextBox x:Name="EndStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Bước đai giữa (mm)"/><TextBox x:Name="MidStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Width="285" VerticalAlignment="Center" Text="Quy tắc Rebar Set"/><ComboBox x:Name="TieLayoutBox" Width="230" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"><ComboBoxItem Content="Maximum Spacing (bước đai tối đa)"/></ComboBox></StackPanel>
                    <CheckBox x:Name="GroupTiesCheck" Margin="0,5" Content="Nhóm đai thành Rebar Set" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <StackPanel Visibility="Collapsed" Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Số đai vùng đầu (mỗi đầu)"/><TextBox x:Name="EndCountBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Visibility="Collapsed" Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Số đai vùng giữa"/><TextBox x:Name="MidCountBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Grid.Row="0" Header="Kiểu đai và móc" Style="{StaticResource PanelGroup}">
                <StackPanel Margin="8">
                    <StackPanel Visibility="Collapsed"><TextBlock Style="{StaticResource FormLabel}" Text="Đai bao (Shape tự động)"/><ComboBox x:Name="OuterTieShapeBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/></StackPanel>
                    <TextBlock Text="Chọn kiểu đai theo chi tiết đã duyệt. Hook được lấy từ loại Hook tương thích sẵn có trong project." TextWrapping="Wrap" Foreground="#FF315889" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><RadioButton x:Name="HookRadio" GroupName="TieShape" Content="Đai móc 135°" Checked="TieStyle_Changed" Margin="0,0,18,0"/><RadioButton x:Name="LoopRadio" GroupName="TieShape" Content="Đai lồng kín" Checked="TieStyle_Changed"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Width="165" VerticalAlignment="Center" Text="Hook đai 135°"/><ComboBox x:Name="TieHook135Box" Width="300" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="165" VerticalAlignment="Center" Text="Hook đai phụ 90°"/><ComboBox x:Name="TieHook90Box" Width="300" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/></StackPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="0" Grid.Row="1" Header="Đai phụ / cross-tie" Style="{StaticResource PanelGroup}">
                <StackPanel Margin="8">
                    <CheckBox x:Name="CrossCheck" Margin="0,4,0,8" Content="Tạo đai phụ giữ các thanh giữa cạnh" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <CheckBox x:Name="CrossAlternateCheck" Margin="20,0,0,8" Content="Luân phiên đảo chiều móc đai phụ (90°–135°)" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <TextBlock Text="KStruct chỉ tạo đai phụ khi tìm được RebarShape và Hook tương thích trong project." TextWrapping="Wrap" Foreground="#FF315889"/>
                    <TextBlock Style="{StaticResource FormLabel}" Text="Đai phụ / cross-tie" Visibility="Collapsed"/><ComboBox Visibility="Collapsed" x:Name="CrossTieShapeBox" Width="590" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Grid.Column="2" Grid.Row="1" Header="Tùy chọn liên kết" Style="{StaticResource PanelGroup}">
                <StackPanel Margin="8">
                    <CheckBox x:Name="OverwriteCheck" Content="Thay thép V3 cũ (bảo vệ Tag/Dim)" ToolTip="Chỉ thay các Rebar thuộc đúng Partition KStruct của cột đã chọn."/>
                    <TextBlock Text="Các vùng đai nút dầm/sàn không tự dò hoặc tự thêm vào. Cấu tạo và khoảng cách phải theo thiết kế đã duyệt." TextWrapping="Wrap" Foreground="#FF9C3D26" Margin="0,8,0,0"/>
                    <RadioButton x:Name="DistributedRadio" IsChecked="True" Content="Phân bố đều" Visibility="Collapsed"/>
                    <CheckBox Visibility="Collapsed" x:Name="JointTiesCheck" Margin="0,8,0,5" Content="Đai nút phía trên đỉnh cột (trong đoạn thép chờ)" ToolTip="Chiều cao nút do người dùng nhập; không tự phát hiện dầm/sàn. Cần thép chờ đủ dài." Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <StackPanel Visibility="Collapsed" Orientation="Horizontal" Margin="20,2,0,4"><TextBlock Width="265" VerticalAlignment="Center" Text="Chiều cao nút dầm sàn (mm)"/><TextBox x:Name="JointHeightBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Visibility="Collapsed" Orientation="Horizontal" Margin="20,2,0,8"><TextBlock Width="265" VerticalAlignment="Center" Text="Bước đai trong nút dầm (mm)"/><TextBox x:Name="JointStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</TabItem>
<TabItem Header="Thép móng">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Thép chờ và neo chân L" Margin="0,0,0,10"/>
                    <TextBlock Text="Cùng thiết lập thép chờ ở tab Hình học; thay đổi được đồng bộ hai tab." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LegacyConnectionSummary" TextWrapping="Wrap" Foreground="#FF9A5700" Margin="0,0,0,6"/>
                    <CheckBox x:Name="StarterCheck" Content="Thép chờ lên tầng trên (kể cả khi chưa có cột tầng trên)" Margin="0,4,0,8" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="Chiều dài chờ từ đỉnh cột dưới (mm)" Width="280" VerticalAlignment="Center"/>
                        <TextBox x:Name="StarterLengthBox" Style="{StaticResource EditorText}" Width="125" LostFocus="Text_LostFocus"/>
                    </StackPanel>
                    <GroupBox Header="Ghép thanh và nhấn cổ chai giữa hai tầng" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Thanh dưới nhấn vào trong, thanh trên giữ thẳng. Chiều dài chờ gồm khoảng hở dầm/sàn và đoạn nối; không tự tăng chiều dài đã nhập." TextWrapping="Wrap"/>
                            <CheckBox x:Name="BottleneckRibbedCheck" Content="Thép dọc có gân (bỏ chọn nếu thép trơn)" Margin="0,8,0,4" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                            <CheckBox x:Name="AllowExistingBendCheck" Margin="0,5,0,2" Foreground="#FF9C3D26"
                                      Content="Ngoại lệ theo thiết kế: dùng Standard Bend Diameter hiện có, không tạo RebarBarType"
                                      Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF9C3D26" Margin="22,0,0,8"
                                       Text="Chỉ đánh dấu khi kỹ sư kết cấu đã duyệt bán kính uốn nhỏ hơn ngưỡng kiểm tra. KStruct vẫn kiểm tra hình học; không xác nhận đạt TCVN."/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Khe hở giữa hai thanh nối (mm)" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckClearanceBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Tỷ lệ xiên dựng hình 1:n" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckSlopeBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus" ToolTip="n là chiều cao đoạn nhấn / độ dịch ngang; mặc định hình học 6, không phải tỷ lệ được quy định trong TCVN 5574:2018."/></StackPanel>
                            <DataGrid x:Name="ConnectionComparisonGrid" Margin="0,8,0,4" MaxHeight="240" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thông số" Binding="{Binding Parameter}" Width="160"/>
                                    <DataGridTextColumn Header="Tầng dưới" Binding="{Binding Lower}" Width="*"/>
                                    <DataGridTextColumn Header="Tầng trên" Binding="{Binding Upper}" Width="*"/>
                                    <DataGridTextColumn Header="So sánh" Binding="{Binding Status}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ConnectionPairingStatus" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,5,0,0"/>
                            <TextBlock x:Name="StarterConnectionSummary" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,7,0,0"/>
                            <TextBlock Text="TCVN 5574:2018: kiểm tra gối uốn theo 10.3.7 và giới hạn dưới đoạn nối theo 10.3.6.2. Chiều dài nối tính toán và cấu tạo đai vẫn lấy theo thiết kế." TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Border BorderBrush="#FFD8DFEA" BorderThickness="1" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.ColumnSpan="2" x:Name="FoundationAnchorCheck" Content="Neo chân L xuống móng tại chân tuyến" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,10" Checked="FoundationAnchor_Changed" Unchecked="FoundationAnchor_Changed"/>
                            <StackPanel Grid.Row="1" Margin="0,0,14,0">
                                <TextBlock Text="Tổng kích thước đoạn đứng + chân ngang (mm)" TextWrapping="Wrap"/>
                                <TextBox x:Name="FoundationLengthBox" Style="{StaticResource EditorText}" Width="150" HorizontalAlignment="Left" LostFocus="FoundationAnchor_Changed" IsEnabled="False"/>
                                <TextBlock Text="Cover móng tại đáy và bên (mm)" Margin="0,6,0,0"/>
                                <TextBox x:Name="FoundationCoverBox" Style="{StaticResource EditorText}" Width="150" HorizontalAlignment="Left" LostFocus="FoundationAnchor_Changed" IsEnabled="False"/>
                                <TextBlock Text="Hướng chân neo theo trục cột" Margin="0,6,0,0"/>
                                <ComboBox x:Name="FoundationDirectionBox" Style="{StaticResource EditorCombo}" IsEnabled="False" SelectionChanged="FoundationAnchor_Changed">
                                    <ComboBoxItem Content="Vào tâm — vuông góc từng cạnh"/>
                                    <ComboBoxItem Content="Ra ngoài — vuông góc từng cạnh"/>
                                    <ComboBoxItem Content="Cùng hướng +X cột"/><ComboBoxItem Content="Cùng hướng -X cột"/>
                                    <ComboBoxItem Content="Cùng hướng +Y cột"/><ComboBoxItem Content="Cùng hướng -Y cột"/>
                                </ComboBox>
                                <TextBlock Text="Số thanh lấy từ Cx/Cy. Bật Nhóm thép dọc ở tab Hình học để tạo Fixed Number; các thanh góc không lặp." TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <CheckBox x:Name="OpenAnchorModelCheck" IsChecked="True" IsEnabled="False" Margin="0,10,0,4" Content="Mở view 3D kiểm tra sau khi tạo"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Sơ đồ hướng chân neo (trục cột)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border Background="#FFF4F7FA" BorderBrush="#FFD8DFEA" BorderThickness="1">
                                    <Canvas x:Name="FoundationCanvas" Height="240" ClipToBounds="True" SizeChanged="FoundationCanvas_SizeChanged"/>
                                </Border>
                                <TextBlock Text="Mũi tên là hướng chân L, không biểu diễn chiều dài. Trục cột xoay/mirror theo family trong mô hình." FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="FoundationAnchorSummary" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF315889"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF9C3D26"
                        Text="Chỉ dựng theo thiết kế đã duyệt; không tự tính neo/nối. Tổng kích thước nhập không phải chiều dài gia công sau uốn; lấy chiều dài thực từ Revit. Ghép cổ chai theo vị trí thực khi cùng số thanh; nối so le và tự bổ sung/kết thúc khi đổi số thanh chưa được hỗ trợ. Bản vẽ là DRAFT."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
<TabItem Header="Cài đặt chung"><Grid x:Name="DeploymentHost" Background="White"/></TabItem></TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

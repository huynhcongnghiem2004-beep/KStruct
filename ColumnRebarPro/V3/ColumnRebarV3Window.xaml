<Window x:Class="ColumnRebarPro.V3.ColumnRebarV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KStruct V4.0 – Tạo thép cột | Revit 2024" Width="1648" Height="930"
        MinWidth="1360" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#FFEAF0F7" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- KStruct palette is applied to the entire Column V4 interior, not only the window chrome. -->
        <SolidColorBrush x:Key="KStructNavy" Color="#FF172F4C"/>
        <SolidColorBrush x:Key="KStructBlue" Color="#FF254C76"/>
        <SolidColorBrush x:Key="KStructEarth" Color="#FFE58A21"/>
        <SolidColorBrush x:Key="KStructCream" Color="#FFF0F4FA"/>
        <SolidColorBrush x:Key="KStructSurface" Color="#FFF5F7FA"/>
        <!-- Four primary WPF tabs share the navy/orange mockup visual language. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FF294565"/>
            <Setter Property="Background" Value="#FFF1F5FA"/>
            <Setter Property="BorderBrush" Value="#FFCED8E5"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <Setter Property="Background" Value="#FF183755"/>
                    <Setter Property="BorderBrush" Value="#FFE58A21"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MockupSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF173654"/>
            <Setter Property="Margin" Value="4,8,4,8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
        </Style>
        <SolidColorBrush x:Key="LineBrush" Color="#FFD2D8E0"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#FFF5F6F8"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#FF254D78"/>
        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="EditorCombo">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>
        <Style TargetType="TextBox" x:Key="EditorText">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB7BEC9"/>
        </Style>
        <!-- Shared KStruct interior controls: navy text, earth-brown focus and light cream sections. -->
        <Style x:Key="AnchorageDisabledText" TargetType="TextBox" BasedOn="{StaticResource EditorText}">
            <Style.Triggers><Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF52647A"/>
                <Setter Property="Background" Value="#FFE9EEF5"/>
                <Setter Property="BorderBrush" Value="#FFB7C4D4"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style x:Key="AnchorageDisabledCombo" TargetType="ComboBox" BasedOn="{StaticResource EditorCombo}">
            <Style.Triggers><Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#FF52647A"/>
                <Setter Property="Background" Value="#FFE9EEF5"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFBFA68D"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFBFA68D"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="BorderBrush" Value="#FFD5C7B8"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="BorderBrush" Value="#FFD5C7B8"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FFF5F7FA"/>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource KStructNavy}"/>
            <Setter Property="BorderBrush" Value="#FFD5C7B8"/>
        </Style>
        <Style TargetType="GroupBox" x:Key="PanelGroup">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Persistent command bar matches mockup; legacy controls are retained inside advanced tabs. -->
        <Border DockPanel.Dock="Bottom" Background="#FFF0F4FA" BorderBrush="#FFD2D8E0" BorderThickness="0,1,0,0" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Content="Tạo thép 3D" IsChecked="True" IsEnabled="False" VerticalAlignment="Center" Margin="0,0,22,0" ToolTip="Chế độ KStruct V4 hiện tạo Rebar 3D trước khi triển khai bản vẽ."/>
                <CheckBox Grid.Column="1" x:Name="QuickDrawingCheck" Content="Tạo bản vẽ triển khai" VerticalAlignment="Center" Margin="0,0,22,0" Checked="QuickDrawing_Changed" Unchecked="QuickDrawing_Changed"/>
                <CheckBox Grid.Column="2" x:Name="QuickAdvancedCheck" Visibility="Collapsed" Content="Mở thiết lập chi tiết" VerticalAlignment="Center" Checked="QuickAdvanced_Changed" Unchecked="QuickAdvanced_Changed"/>
                <Button Grid.Column="4" Style="{StaticResource FlatButton}" Content="Kiểm tra V5" Width="110" Click="V5Review_Click" Margin="0,0,5,0"/>
                <Button Grid.Column="5" Style="{StaticResource FlatButton}" Content="Xem trước dữ liệu" Width="155" Click="QuickPreview_Click"/>
                <Button Grid.Column="6" x:Name="RunButton" Content="⚙  KIỂM TRA &amp; TẠO THÉP" FontWeight="SemiBold" Foreground="White" Background="#FFE58A21" BorderBrush="#FFD97816" Padding="21,9" Margin="8,0,4,0" IsDefault="True" Click="Run_Click"/>
                <Button Grid.Column="7" Style="{StaticResource FlatButton}" Content="Hủy" IsCancel="True" Click="Cancel_Click"/>
            </Grid>
        </Border>
        <Grid Margin="10,6">
            <!-- Legacy controls are retained so V4 configurations, hookups and deployment keep working. -->
            <Grid x:Name="AdvancedSurface">
                <TabControl x:Name="MainTabs" BorderBrush="{StaticResource LineBrush}">
                    <TabItem Header="▥  1. TẠO THÉP CỘT">
                        <TabControl x:Name="ColumnModeTabs" BorderThickness="0" Background="Transparent">
                            <TabItem Header="Tạo thép nhanh">
            <Grid x:Name="CompactSurface">
                <Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="8,0,8,8" Background="#FF17365D">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="▥" FontSize="34" Foreground="#FFF8FAFC" VerticalAlignment="Center" Margin="12,0,18,0"/>
                        <Border Width="2" Height="34" Background="#FF64748B" Margin="0,0,20,0"/>
                        <TextBlock Text="BỐ TRÍ CỐT THÉP CỘT NHIỀU TẦNG" FontWeight="Bold" FontSize="20" Foreground="#FFF8FAFC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FF254D78" Padding="12,6" CornerRadius="5" VerticalAlignment="Center">
                        <TextBlock Text="KStruct · Column Rebar V4" Foreground="#FFE2E8F0" FontSize="13"/>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="19*"/><ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="51*"/><ColumnDefinition Width="9"/>
                        <ColumnDefinition Width="30*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 01 — compact stack selection -->
                    <Border Grid.Column="0" BorderBrush="#FFD5C7B8" BorderThickness="1" CornerRadius="8" Background="White">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FFEDE5DA" Padding="12,11">
                                <TextBlock Text="01. Danh sách tầng" FontSize="18" FontWeight="Bold" Foreground="#FF17365D"/>
                            </Border>
                            <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}" Margin="10,9" Height="38" Content="Áp dụng cho tất cả tầng" Click="ApplyAll_Click"/>
                            <StackPanel DockPanel.Dock="Top" Margin="12,8,12,0">
                                <TextBlock x:Name="CountLabel" Text="Số lượng: 0" FontSize="11" Foreground="#FF66788C"/>
                            </StackPanel>
                            <ListBox x:Name="FloorList" Margin="10,5,10,6" BorderBrush="#FFDBE1EA" BorderThickness="1"
                                     SelectionChanged="FloorList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="MinHeight" Value="50"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#FFEDE5DA"/><Setter Property="Foreground" Value="#FF17365D"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="49" Margin="9,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="▤" Foreground="#FF986B48" FontSize="17" Margin="0,0,9,0"/>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FloorTitle}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BarText}" FontSize="10" Foreground="#FF6A7B8E"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontSize="11" Foreground="#FF4A5E77" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <!-- 03 — compact property inspector backed by existing V4 controls -->
                    <Border Grid.Column="4" BorderBrush="#FFD5C7B8" BorderThickness="1" CornerRadius="8" Background="White">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FFEDE5DA" Padding="12,11">
                                <TextBlock Text="03. Cấu hình thép" FontSize="18" FontWeight="Bold" Foreground="#FF17365D"/>
                            </Border>
                            <Border DockPanel.Dock="Top" Background="#FFF8FAFC" BorderBrush="#FFDCE2EB" BorderThickness="0,0,0,1" Padding="5,5">
                                <UniformGrid Columns="3">
                                    <Button Content="Neo / chuyển tiếp" Background="#FFF5F7FA" BorderBrush="#FFBFA68D" BorderThickness="1,1,1,3" Foreground="#FF254D78" FontSize="10" FontWeight="SemiBold" MinHeight="36" Padding="3,6" Margin="2,0" ToolTip="Mở thiết lập nâng cao cho neo và chuyển tiếp" Click="QuickAdvanced_Click"/>
                                    <Button Content="Hook / RebarShape" Background="#FFF5F7FA" BorderBrush="#FFBFA68D" BorderThickness="1,1,1,3" Foreground="#FF254D78" FontSize="10" FontWeight="SemiBold" MinHeight="36" Padding="3,6" Margin="2,0" ToolTip="Mở thiết lập nâng cao cho Hook và RebarShape" Click="QuickAdvanced_Click"/>
                                    <Button Content="Thông số kiểm tra" Background="#FFF5F7FA" BorderBrush="#FFBFA68D" BorderThickness="1,1,1,3" Foreground="#FF254D78" FontSize="10" FontWeight="SemiBold" MinHeight="36" Padding="3,6" Margin="2,0" ToolTip="Mở thiết lập nâng cao để kiểm tra thông số" Click="QuickAdvanced_Click"/>
                                </UniformGrid>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="18,17,16,12">
                                    <TextBlock Text="1. TIẾT DIỆN &amp; VẬT LIỆU" FontWeight="SemiBold" Foreground="#FF17365D" Margin="0,12,0,8"/><Border Height="1" Background="#FFD6DCE6" Margin="0,0,0,7"/>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Rộng B (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickWidthBox" Height="27" IsReadOnly="True" Background="#FFF3F5F8" Padding="6,0" VerticalContentAlignment="Center" ToolTip="Tiết diện được đọc từ cột Revit. Chỉnh kích thước qua Family/Type trong mô hình."/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Cao H (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickHeightBox" Height="27" IsReadOnly="True" Background="#FFF3F5F8" Padding="6,0" VerticalContentAlignment="Center" ToolTip="Tiết diện được đọc từ cột Revit. Chỉnh kích thước qua Family/Type trong mô hình."/></StackPanel></Grid>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Bảo vệ Cover (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickCoverBox" Height="27" Padding="6,0" VerticalContentAlignment="Center" LostFocus="QuickText_LostFocus"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Cao dầm sàn (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickBeamHeightBox" Height="27" Padding="6,0" VerticalContentAlignment="Center" LostFocus="QuickText_LostFocus"/></StackPanel></Grid>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Bê tông (TCVN):" Margin="0,0,0,3"/><ComboBox x:Name="QuickConcreteBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Thép dọc:" Margin="0,0,0,3"/><ComboBox x:Name="QuickSteelGradeBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel></Grid>
                                    <TextBlock Text="Mác vật liệu chỉ phục vụ tham chiếu giao diện, chưa ghi đè thuộc tính vật liệu Revit." FontSize="10" Foreground="#FF986B48" TextWrapping="Wrap"/>
                                    <TextBlock Text="2. BỐ TRÍ CỐT THÉP CHỦ (MAIN BARS)" FontWeight="SemiBold" Foreground="#FF17365D" Margin="0,12,0,8"/><Border Height="1" Background="#FFD6DCE6" Margin="0,0,0,7"/>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Số thanh cạnh B (X):" Margin="0,0,0,3"/><ComboBox x:Name="QuickCxBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Số thanh cạnh H (Y):" Margin="0,0,0,3"/><ComboBox x:Name="QuickCyBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel></Grid>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Đường kính thép (mm):" Margin="0,0,0,3"/><ComboBox x:Name="QuickMainBarBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,9"><CheckBox x:Name="QuickLapCheck" Content="Nối so le 50%" IsEnabled="False" ToolTip="Tùy chọn này chỉ được bật sau khi có xử lý nối so le thực tế trong lõi tạo thép."/></StackPanel></Grid>
                                    <TextBlock Text="3. CỐT THÉP ĐAI (STIRRUPS &amp; C-TIES)" FontWeight="SemiBold" Foreground="#FF17365D" Margin="0,12,0,8"/><Border Height="1" Background="#FFD6DCE6" Margin="0,0,0,7"/>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Đường kính đai:" Margin="0,0,0,3"/><ComboBox x:Name="QuickTieBarBox" Height="27" SelectionChanged="QuickInput_Changed"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Vùng đai dày (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickZoneBox" Height="27" Padding="6,0" VerticalContentAlignment="Center" LostFocus="QuickText_LostFocus"/></StackPanel></Grid>
                                    <Grid Margin="0,0,0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,0,7"><TextBlock Text="Bước đai dày s1 (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickEndBox" Height="27" Padding="6,0" VerticalContentAlignment="Center" LostFocus="QuickText_LostFocus"/></StackPanel><StackPanel Grid.Column="2" Margin="0,0,0,7"><TextBlock Text="Bước đai thưa s2 (mm):" Margin="0,0,0,3"/><TextBox x:Name="QuickMidBox" Height="27" Padding="6,0" VerticalContentAlignment="Center" LostFocus="QuickText_LostFocus"/></StackPanel></Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4"><TextBlock Text="Kiểu đai:" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="QuickTieStyleBox" Width="160" SelectionChanged="QuickInput_Changed"><ComboBoxItem Content="Đai móc 135°"/><ComboBoxItem Content="Đai lồng kín"/></ComboBox></StackPanel>
                                    <CheckBox x:Name="QuickStarterCheck" Content="Có thép chờ lên tầng trên" Margin="2,16,0,8"
                                              Checked="QuickInput_Changed" Unchecked="QuickInput_Changed"/>
                                    <CheckBox x:Name="QuickJointTiesCheck" Content="Đai nút khung" IsChecked="True"
                                              Margin="2,2,0,20" Checked="QuickInput_Changed" Unchecked="QuickInput_Changed"
                                              ToolTip="Bật: giữ đai tại vùng giao dầm/sàn. Tắt: loại vị trí đai ở vùng giao được phát hiện. Chỉ sử dụng khi cấu tạo đã được kỹ sư duyệt."/>
                                    <TextBlock Margin="3,20,0,0" Foreground="#FF986B48" FontSize="11" TextWrapping="Wrap"
                                               Text="Dùng các thẻ Neo, Hook / RebarShape hoặc Thông số kiểm tra phía trên để mở thiết lập nâng cao."/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <!-- 02 — existing live previews, restyled to match the reference add-in -->
                    <Border Grid.Column="2" BorderBrush="#FFD5C7B8" BorderThickness="1" CornerRadius="6" Background="White" Margin="0,0,8,0">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="58*"/></Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Background="#FF17365D" Padding="10,9"><TextBlock Text="MẶT CẮT NGANG · THEO TỪNG TẦNG" Foreground="White" FontWeight="Bold"/></Border>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="FloorSectionPreviewStack">
                                        <TextBlock Text="Mặt cắt đang chọn" Margin="10,7" FontWeight="SemiBold"/>
                                        <Grid Height="300"><Canvas x:Name="SectionCanvas" Margin="8" ClipToBounds="True" Background="White" SizeChanged="SectionCanvas_SizeChanged"/></Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="#FFD5DDE8"/>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Border Background="#FF17365D" Padding="10,9"><TextBlock Text="MẶT CẮT ĐỨNG · TOÀN TUYẾN CỘT / LEVEL / NÚT DẦM" Foreground="White" FontWeight="Bold"/></Border>
                                <Canvas Grid.Row="1" x:Name="LongSectionCanvas" MinWidth="250" MinHeight="350" Margin="8" ClipToBounds="True" Background="White" SizeChanged="LongSectionCanvas_SizeChanged" PreviewMouseLeftButtonDown="LongSectionCanvas_MouseLeftButtonDown" MouseLeftButtonUp="LongSectionCanvas_MouseLeftButtonUp" MouseMove="LongSectionCanvas_MouseMove" MouseWheel="LongSectionCanvas_MouseWheel" LostMouseCapture="LongSectionCanvas_LostMouseCapture"/>
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource FlatButton}" Content="+" Click="LongSectionZoomIn_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="−" Click="LongSectionZoomOut_Click"/>
                                    <Button Style="{StaticResource FlatButton}" Content="Vừa khung" Click="LongSectionZoomFit_Click"/>
                                    <TextBlock x:Name="LongSectionZoomLabel" Text="100%" VerticalAlignment="Center" Margin="8"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

                            </TabItem>
                            <TabItem Header="Thiết lập chi tiết" Visibility="Collapsed" IsEnabled="False">
                        <Grid Background="White">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="400"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="140"/></Grid.RowDefinitions>
                                                <Grid Grid.Column="4" Grid.Row="0" Margin="1,1,1,1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="03 · THIẾT LẬP THÉP CỘT" FontWeight="Bold"
                                   Foreground="#FF235A53" Margin="7,8,0,8"/>
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="5,6,7,3">
                                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Số lượng thép cạnh Cx"/><ComboBox Grid.Column="1" x:Name="CxBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>

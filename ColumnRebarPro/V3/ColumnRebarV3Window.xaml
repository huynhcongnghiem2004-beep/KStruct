                                    <CheckBox IsEnabled="False" Margin="0,6,0,6" Content="Sử dụng thép bổ sung (sắp có)"/>
                                    <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Tổng hợp số cốt thép"/><TextBlock Grid.Column="1" x:Name="TotalBarsText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Diện tích cốt thép (cm²)"/><TextBlock Grid.Column="1" x:Name="AreaText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Hàm lượng cốt thép"/><TextBlock Grid.Column="1" x:Name="RatioText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Đường kính cốt đai chính"/><ComboBox Grid.Column="1" x:Name="TieBarBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>
                                    <TextBlock Margin="0,7,0,2" FontWeight="SemiBold" Text="Tự nhận diện hình thép từ project"/>
                                    <TextBlock Text="KStruct dùng hình học thiết kế để Revit tự khớp RebarShape hiện có. Không phải chọn Shape; không tự tạo Shape mới." TextWrapping="Wrap" Foreground="#FF315889" Margin="0,0,0,3"/>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Thanh dọc thẳng" Visibility="Collapsed"/>
                                    <ComboBox Visibility="Collapsed" x:Name="LongitudinalShapeBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    <TextBlock Style="{StaticResource FormLabel}" Text="Thanh neo / chuyển tiếp" Visibility="Collapsed"/>
                                    <ComboBox Visibility="Collapsed" x:Name="AnchorShapeBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    <CheckBox x:Name="GroupLongCheck" Margin="0,7,0,3" Content="Nhóm thép dọc (Fixed Number)" ToolTip="Tạo Fixed Number cho thanh thẳng và neo chân L theo cạnh; cạnh có 1 thanh dùng Single." Checked="Edit_Changed" Unchecked="Edit_Changed"/>

                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>
                                    <CheckBox x:Name="MainStarterCheck" Margin="0,2,0,3" Content="Thép chờ lên tầng trên (Starter Bars)" FontWeight="SemiBold" Foreground="#FF1B4EB0" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Chờ từ đỉnh cột dưới (mm)"/>
                                        <TextBox Grid.Column="1" x:Name="MainStarterLengthBox" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Button Grid.Row="2" Style="{StaticResource FlatButton}" Content="Áp dụng cho tất cả tầng" Margin="4,7,4,4" Height="28" Click="ApplyAll_Click"/>
                    </Grid>

                                                <!-- BOTTOM: COLUMN JOINT INFORMATION -->
                    <GroupBox Grid.Column="4" Grid.Row="1" Margin="3,4,3,2"
                              Header="Thông tin cột tại vị trí đang chọn" BorderBrush="{StaticResource LineBrush}">
                        <Grid Margin="7,4,5,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Chiều cao nút (tham khảo)"/>

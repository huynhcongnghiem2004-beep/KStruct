                                   ToolTip="Chỉ dùng khi thép tầng trên nhiều hơn; nhập chiều dài neo theo chi tiết được duyệt. Để trống nếu không dùng."/>
                        <TextBox x:Name="SupplementalAnchorLengthBox" Style="{StaticResource EditorText}" Width="125" LostFocus="Text_LostFocus"
                                 ToolTip="Chỉ dùng khi thép tầng trên nhiều hơn; nhập chiều dài neo theo chi tiết được duyệt. Để trống nếu không dùng."/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="Lớp bảo vệ phía trên dầm (mm)" Foreground="#FF173657" Width="235" VerticalAlignment="Center"
                                   ToolTip="Chỉ dùng để xác định đầu thanh dư; nhập lớp bảo vệ trên dầm theo bản vẽ."/>
                        <TextBox x:Name="BeamTopCoverBox" Style="{StaticResource EditorText}" Width="125" LostFocus="Text_LostFocus"
                                 ToolTip="Chỉ dùng để xác định đầu thanh dư; nhập lớp bảo vệ trên dầm theo bản vẽ."/>
                    </StackPanel>
                    <GroupBox Header="Ghép thanh và nhấn cổ chai giữa hai tầng" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Thanh dưới nhấn vào trong, thanh trên giữ thẳng. Chiều dài chờ gồm khoảng hở dầm/sàn và đoạn nối; không tự tăng chiều dài đã nhập." TextWrapping="Wrap"/>
                            <CheckBox x:Name="BottleneckRibbedCheck" Content="Thép dọc có gân (bỏ chọn nếu thép trơn)" Margin="0,8,0,4" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                            <CheckBox x:Name="AllowExistingBendCheck" Margin="0,5,0,2" Foreground="#FF986B48"
                                      Content="Ngoại lệ theo thiết kế: dùng Standard Bend Diameter hiện có, không tạo RebarBarType"
                                      Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#FF986B48" Margin="22,0,0,8"
                                       Text="Chỉ đánh dấu khi kỹ sư kết cấu đã duyệt bán kính uốn nhỏ hơn ngưỡng kiểm tra. KStruct vẫn kiểm tra hình học; không xác nhận đạt TCVN."/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Khe hở giữa hai thanh nối (mm)" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckClearanceBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Tỷ lệ xiên dựng hình 1:n" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckSlopeBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus" ToolTip="n là chiều cao đoạn nhấn / độ dịch ngang; nhập theo chi tiết được duyệt. Add-in không tự chọn tỷ lệ và không coi đây là giá trị TCVN."/></StackPanel>
                            <DataGrid x:Name="ConnectionComparisonGrid" Margin="0,8,0,4" MaxHeight="240" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thông số" Binding="{Binding Parameter}" Width="160"/>
                                    <DataGridTextColumn Header="Tầng dưới" Binding="{Binding Lower}" Width="*"/>
                                    <DataGridTextColumn Header="Tầng trên" Binding="{Binding Upper}" Width="*"/>
                                    <DataGridTextColumn Header="So sánh" Binding="{Binding Status}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ConnectionPairingStatus" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,5,0,0"/>
                            <TextBlock x:Name="StarterConnectionSummary" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,7,0,0"/>
                            <TextBlock Text="TCVN 5574:2018: kiểm tra gối uốn theo 10.3.7 và giới hạn dưới đoạn nối theo 10.3.6.2. Chiều dài nối tính toán và cấu tạo đai vẫn lấy theo thiết kế." TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    </StackPanel>
                    <Border Background="#FFEAF0F7" Padding="10" CornerRadius="5" Margin="0,4,0,10"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FF173657" Text="03  |  NÚT GIAO DẦM – CỘT"/></Border>
                    <Border BorderBrush="#FFD8DFEA" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock FontWeight="SemiBold" Text="Xác minh dầm từ mô hình Revit" Foreground="#FF173657"/><TextBlock Text="Chiều cao dầm khác với khe hở giữa hai đoạn cột. Hai cột tiếp giáp 0 mm không tự động là sai hình học. KStruct kiểm tra dầm thực tế tại bước tạo thép; chiều cao nhập tay không thay thế xác minh hình học." TextWrapping="Wrap" Margin="0,6,0,0"/><TextBlock Text="Đối với dầm giao nhiều hướng hoặc khác chiều cao, cần kiểm tra riêng từng cấu kiện trước khi chấp thuận neo/nối." Foreground="#FF986B48" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                    <Border Background="#FFEAF0F7" Padding="10" CornerRadius="5" Margin="0,0,0,10"><TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#FF173657" Text="04  |  KẾT THÚC THÉP CỘT MÁI"/></Border>
                    <Border BorderBrush="#FFD8DFEA" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,12"><StackPanel><TextBlock FontWeight="SemiBold" Text="Móc 90° hướng vào tâm cột" Foreground="#FF173657"/><TextBlock Text="Cấu hình móc đỉnh cột nằm trong thông số thép dọc. Chỉ áp dụng cho cột cuối tuyến, không có nối tầng phía trên. Nếu không đủ không gian uốn và chiều dài neo thiết kế, giữ thanh thẳng và cảnh báo chưa xác minh neo." TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF986B48"
                        Text="Chỉ dựng theo thiết kế đã duyệt; không tự tính neo/nối. Tổng kích thước nhập không phải chiều dài gia công sau uốn; lấy chiều dài thực từ Revit. Ghép cổ chai theo vị trí thực khi cùng số thanh; nối so le và tự bổ sung/kết thúc khi đổi số thanh chưa được hỗ trợ. Bản vẽ là DRAFT."/>
                </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Column="1" Background="White" BorderBrush="#FFD2DDE9" BorderThickness="1,0,1,0" Padding="10">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FF173657" Padding="11" CornerRadius="5" Margin="0,0,0,10">
                                <TextBlock Text="MẶT ĐỨNG TOÀN TUYẾN" Foreground="White" FontWeight="Bold" FontSize="13"/>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Text="Đỏ liền: đường tâm builder đã xác minh. Cam đứt: chưa đủ dữ liệu hình học; không dùng để gia công." FontSize="11" TextWrapping="Wrap" Foreground="#FF986B48" Margin="3,8,3,0"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Background="#FFF7F9FC" BorderBrush="#FFD2DDE9" BorderThickness="1" CornerRadius="5" Padding="5" Margin="0,0,0,9">

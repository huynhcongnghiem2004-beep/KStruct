                                    </Border>
                                    <TextBlock Text="CHỌN TẦNG ĐỂ CHỈNH THÔNG SỐ" FontWeight="SemiBold" Foreground="#FF173657" Margin="0,0,0,7"/>
                                <ItemsControl x:Name="AnchorageRouteList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF4F7FA" BorderBrush="#FFD2DDE9" BorderThickness="1" CornerRadius="5" Padding="9" Margin="0,0,0,7">
                                                <StackPanel>
                                                    <Button Content="{Binding Segment.LevelName}" Tag="{Binding Segment.Id}" Click="AnchorageReviewFloor_Click" Background="#FFEAF0F7" Foreground="#FF173657" FontWeight="SemiBold" Padding="6" HorizontalContentAlignment="Left" ToolTip="Chọn tầng này để chỉnh thông số"/>
                                                    <TextBlock Text="{Binding HeightText}" Foreground="#FF556A80" FontSize="11" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding SizeText}" Foreground="#FF556A80" FontSize="11"/>
                                                    <TextBlock Text="{Binding BarText}" Foreground="#FF986B48" FontSize="11" Margin="0,3,0,0"/>
                                                    <TextBlock Text="{Binding TieTag}" Foreground="#FF556A80" FontSize="11" TextWrapping="Wrap"/>
                                                    <Grid Height="34" Margin="0,6,0,0" Visibility="Collapsed">
                                                        <Rectangle Width="34" HorizontalAlignment="Center" Fill="#FFE5EAF0" Stroke="#FF778A9D"/>
                                                        <Rectangle Width="22" HorizontalAlignment="Center" Fill="Transparent" Stroke="#FFD34835" StrokeThickness="2"/>
                                                        <Line X1="0" X2="0" Y1="2" Y2="32" Stroke="#FFD34835" StrokeThickness="2" HorizontalAlignment="Center"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#FFFDFEFF" Padding="10">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="#FF173657" Padding="11" CornerRadius="5" Margin="0,0,0,10">
                                <TextBlock Text="MẶT CẮT NGANG THEO TẦNG" Foreground="White" FontWeight="Bold" FontSize="12"/>
                            </Border>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Border Background="#FFFFF7ED" Padding="9" CornerRadius="5">
                                    <TextBlock Text="Preview hình học sơ bộ, không phải kết quả kiểm tra neo/nối theo TCVN. Kiểm tra lại Rebar 3D trước khi phát hành." TextWrapping="Wrap" FontSize="11" Foreground="#FF986B48"/>
                                </Border>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="AnchorageSectionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#FFD2DDE9" BorderThickness="1" Background="White" CornerRadius="5" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Button Content="{Binding Segment.LevelName}" Tag="{Binding Segment.Id}" Click="AnchorageReviewFloor_Click" Background="#FFEAF0F7" Foreground="#FF173657" FontWeight="SemiBold" HorizontalContentAlignment="Left" Padding="6" ToolTip="Chọn tầng này để chỉnh thông số"/>
                                                    <Border Height="128" Margin="0,7,0,5" Background="#FFF7F9FC" BorderBrush="#FFD2DDE9" BorderThickness="1" Padding="5">
                                                        <Image Source="{Binding SectionPreview}" Stretch="Uniform" ToolTip="Mặt cắt sinh từ cấu hình Cx/Cy, đường kính thép và tiết diện tầng hiện tại"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Center" Foreground="#FF173657" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding BarText}" TextAlignment="Center" Foreground="#FF556A80" FontSize="11"/>
                                                    <TextBlock Text="Preview cấu hình 2D; chưa xác minh va chạm Solid" TextWrapping="Wrap" FontSize="10" Foreground="#FF986B48" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="▧  4. TRIỂN KHAI BẢN VẼ">
                <Grid Background="White">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource KStructCream}" BorderBrush="#FFD5C7B8" BorderThickness="0,0,0,1" Padding="15,12">
                        <StackPanel>
                            <TextBlock Text="CÀI ĐẶT CHUNG · KSTRUCT V4 / CORE V5" Foreground="{StaticResource KStructNavy}" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Các thông số nối, neo, đai và lớp bảo vệ đang được cấu hình trong ba tab tương ứng. Chỉ các tham số đã kết nối với bộ tạo thép mới được phép áp dụng. Không tự suy diễn chiều dài neo/nối theo tiêu chuẩn." TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource KStructEarth}"/>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1" x:Name="DeploymentHost" Background="White"/>
                </Grid>
            </TabItem>
            </TabControl>
            </Grid>
        </Grid>

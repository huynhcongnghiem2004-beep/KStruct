<Window x:Class="ColumnRebarPro.V3.ColumnRebarV3Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KStruct | Column Rebar Pro v3.2" Width="1210" Height="720"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#FFF9FAFC" FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="LineBrush" Color="#FFD2D8E0"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#FFF5F6F8"/>
        <SolidColorBrush x:Key="BlueBrush" Color="#FF1B4EB0"/>
        <Style TargetType="TextBlock" x:Key="FormLabel">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style TargetType="ComboBox" x:Key="EditorCombo">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="IsEditable" Value="False"/>
        </Style>
        <Style TargetType="TextBox" x:Key="EditorText">
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>
        <Style TargetType="Button" x:Key="FlatButton">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="3,2"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB7BEC9"/>
        </Style>
        <Style TargetType="GroupBox" x:Key="PanelGroup">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>
    <DockPanel LastChildFill="True">
        <!-- Bottom buttons match the reference window, while exposing V3 replace option. -->
        <Grid DockPanel.Dock="Bottom" Height="43" Background="#FFF7F7F7">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0">
                <CheckBox x:Name="OverwriteCheck" Content="Ghi đè thép có Partition V3" ToolTip="Chỉ thay thép mang đúng Partition KSTR_V3_ID của cột, kể cả thanh neo host móng. Giữ thép có Partition khác." VerticalAlignment="Center"/>
                <TextBlock Margin="14,0,0,0" Foreground="#FF8A3A32" VerticalAlignment="Center"
                           Text="Đối chiếu thiết kế trước khi chạy"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                <Button x:Name="RunButton" Style="{StaticResource FlatButton}" Width="190" Content="Tạo thép 3D" Background="#FFE9F1FF" IsDefault="True" Click="Run_Click"/>
                <Button Style="{StaticResource FlatButton}" Width="75" Content="Hủy" IsCancel="True" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
        <TabControl x:Name="MainTabs" Margin="4,3,4,0" BorderBrush="{StaticResource LineBrush}">
            <TabItem Header="Hình học &amp; Bố trí thép">
                <Grid Background="White" Margin="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="210"/>
                        <ColumnDefinition Width="246"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="126"/></Grid.RowDefinitions>
                    <!-- COLUMN STACK -->
                    <DockPanel Grid.Column="0" Grid.RowSpan="2" Margin="2,1,2,1">
                        <TextBlock DockPanel.Dock="Top" x:Name="CountLabel" Foreground="#FFB52222" FontWeight="Bold"
                                   Text="Số lượng: 0" Margin="2,3,0,7"/>
                        <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Background="White">
                            <ListBox x:Name="FloorList" BorderThickness="0" Background="Transparent"
                                     SelectionChanged="FloorList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="111" Margin="3,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border BorderBrush="#FFE4E8EA" BorderThickness="0,0,0,1" Grid.ColumnSpan="3"/>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FloorTitle}" FontSize="11" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding HeightText}" FontSize="11" Margin="9,3,0,0"/>
                                            </StackPanel>
                                            <Rectangle Grid.Column="1" Fill="#FF319764" Width="11" HorizontalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,3,0">
                                                <TextBlock Text="{Binding SizeText}" FontSize="10" HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding BarText}" Foreground="Red" FontSize="13" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </DockPanel>
                    <!-- REINFORCEMENT SETTINGS CENTER -->
                    <Grid Grid.Column="1" Grid.Row="0" Margin="1,1,1,1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Hiệu chỉnh cốt thép chữ nhật" Margin="5,5,0,7"/>
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="5,6,7,3">
                                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Số lượng thép cạnh Cx"/><ComboBox Grid.Column="1" x:Name="CxBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Số lượng thép cạnh Cy"/><ComboBox Grid.Column="1" x:Name="CyBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Đường kính cốt thép chính"/><ComboBox Grid.Column="1" x:Name="MainBarBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>
                                    <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Đường kính thép bổ sung"/><ComboBox Grid.Column="1" IsEnabled="False" Style="{StaticResource EditorCombo}" ToolTip="Dự kiến giai đoạn tiếp theo"/>
                                    </Grid>
                                    <CheckBox IsEnabled="False" Margin="0,6,0,6" Content="Sử dụng thép bổ sung (sắp có)"/>
                                    <Grid Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Tổng hợp số cốt thép"/><TextBlock Grid.Column="1" x:Name="TotalBarsText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Diện tích cốt thép (cm²)"/><TextBlock Grid.Column="1" x:Name="AreaText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Hàm lượng cốt thép"/><TextBlock Grid.Column="1" x:Name="RatioText" Foreground="#FF163FA4" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,9,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Đường kính cốt đai chính"/><ComboBox Grid.Column="1" x:Name="TieBarBox" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed"/>
                                    </Grid>
                                    <CheckBox x:Name="GroupLongCheck" Margin="0,7,0,3" Content="Nhóm thép dọc (Fixed Number)" ToolTip="Tạo Fixed Number cho thanh thẳng và neo chân L theo cạnh; cạnh có 1 thanh dùng Single." Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                                    <CheckBox x:Name="GroupTiesCheck" Margin="0,3,0,3" Content="Nhóm thép đai (Rebar Set)" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,6"/>
                                    <CheckBox x:Name="MainStarterCheck" Margin="0,2,0,3" Content="Thép chờ lên tầng trên (Starter Bars)" FontWeight="SemiBold" Foreground="#FF1B4EB0" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                                    <Grid Margin="0,2,0,2">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="107"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource FormLabel}" Text="Chờ từ đỉnh cột dưới (mm)"/>
                                        <TextBox Grid.Column="1" x:Name="MainStarterLengthBox" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Button Grid.Row="2" Style="{StaticResource FlatButton}" Content="Áp dụng cho tất cả tầng" Margin="4,7,4,4" Height="28" Click="ApplyAll_Click"/>
                    </Grid>
                    <!-- SECTION PREVIEW RIGHT -->
                    <Grid Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Margin="1,1,2,1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="Mặt cắt ngang &amp; Loại đai" Margin="6,5,0,4"/>
                        <Border Grid.Row="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="33"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <RadioButton Grid.Column="0" x:Name="DistributedRadio" Content="Phân bố đều" IsChecked="True" VerticalAlignment="Center" FontSize="10.5" Checked="Edit_Changed"/>
                                    <RadioButton Grid.Column="1" Content="Tập trung" IsEnabled="False" ToolTip="Chưa hỗ trợ thuật toán phân bố tập trung" VerticalAlignment="Center" FontSize="10.5"/>
                                    <RadioButton Grid.Column="2" x:Name="HookRadio" GroupName="TieShape" Content="Đai móc" VerticalAlignment="Center" Checked="TieStyle_Changed" FontSize="10.5"/>
                                    <RadioButton Grid.Column="3" x:Name="LoopRadio" GroupName="TieShape" Content="Đai lồng kín" VerticalAlignment="Center" Checked="TieStyle_Changed" FontSize="10.5"/>
                                </Grid>
                                <Border Grid.Row="1" Background="#FFF4F4F4" Margin="4,0,4,4">
                                    <Canvas x:Name="SectionCanvas" ClipToBounds="True" SizeChanged="SectionCanvas_SizeChanged"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Grid.Row="2" Text="Mặt cắt dọc — vị trí đai theo cấu hình" Margin="6,6,0,4"/>
                        <Border Grid.Row="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <Border Background="#FFF4F4F4" Margin="4">
                                <Canvas x:Name="LongSectionCanvas" ClipToBounds="True" SizeChanged="LongSectionCanvas_SizeChanged"/>
                            </Border>
                        </Border>
                    </Grid>
                    <!-- BOTTOM: COLUMN JOINT INFORMATION -->
                    <GroupBox Grid.Column="1" Grid.Row="1" Margin="3,4,3,2"
                              Header="Thông tin cột tại vị trí đang chọn" BorderBrush="{StaticResource LineBrush}">
                        <Grid Margin="7,4,5,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FormLabel}" Text="Cao nút (tab Thép đai)"/>
                            <TextBox Grid.Column="1" x:Name="BeamHeightBox" Style="{StaticResource EditorText}" IsReadOnly="True"/>
                            <TextBlock Grid.Row="1" Style="{StaticResource FormLabel}" Text="Cover ngoài đai (mm)"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="CoverBox" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Thép chờ / Neo móng">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Thép chờ và neo chân L" Margin="0,0,0,10"/>
                    <TextBlock Text="Cùng thiết lập thép chờ ở tab Hình học; thay đổi được đồng bộ hai tab." TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <CheckBox x:Name="StarterCheck" Content="Thép chờ lên tầng trên (kể cả khi chưa có cột tầng trên)" Margin="0,4,0,8" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                        <TextBlock Text="Chiều dài chờ từ đỉnh cột dưới (mm)" Width="280" VerticalAlignment="Center"/>
                        <TextBox x:Name="StarterLengthBox" Style="{StaticResource EditorText}" Width="125" LostFocus="Text_LostFocus"/>
                    </StackPanel>
                    <GroupBox Header="Ghép thanh và nhấn cổ chai giữa hai tầng" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Thanh dưới nhấn vào trong, thanh trên giữ thẳng. Chiều dài chờ gồm khoảng hở dầm/sàn và đoạn nối; không tự tăng chiều dài đã nhập." TextWrapping="Wrap"/>
                            <CheckBox x:Name="BottleneckRibbedCheck" Content="Thép dọc có gân (bỏ chọn nếu thép trơn)" Margin="0,8,0,4" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Khe hở giữa hai thanh nối (mm)" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckClearanceBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="Tỷ lệ xiên dựng hình 1:n" Width="300" VerticalAlignment="Center"/><TextBox x:Name="BottleneckSlopeBox" Width="100" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus" ToolTip="n là chiều cao đoạn nhấn / độ dịch ngang; mặc định hình học 6, không phải tỷ lệ được quy định trong TCVN 5574:2018."/></StackPanel>
                            <DataGrid x:Name="ConnectionComparisonGrid" Margin="0,8,0,4" MaxHeight="240" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thông số" Binding="{Binding Parameter}" Width="160"/>
                                    <DataGridTextColumn Header="Tầng dưới" Binding="{Binding Lower}" Width="*"/>
                                    <DataGridTextColumn Header="Tầng trên" Binding="{Binding Upper}" Width="*"/>
                                    <DataGridTextColumn Header="So sánh" Binding="{Binding Status}" Width="75"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="ConnectionPairingStatus" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,5,0,0"/>
                            <TextBlock x:Name="StarterConnectionSummary" TextWrapping="Wrap" Foreground="#FF315889" Margin="0,7,0,0"/>
                            <TextBlock Text="TCVN 5574:2018: kiểm tra gối uốn theo 10.3.7 và giới hạn dưới đoạn nối theo 10.3.6.2. Chiều dài nối tính toán và cấu tạo đai vẫn lấy theo thiết kế." TextWrapping="Wrap" Margin="0,7,0,0"/>
                        </StackPanel>
                    </GroupBox>
                    <Border BorderBrush="#FFD8DFEA" BorderThickness="1" Padding="12" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                            <CheckBox Grid.ColumnSpan="2" x:Name="FoundationAnchorCheck" Content="Neo chân L xuống móng tại chân tuyến" IsChecked="False" FontWeight="SemiBold" Margin="0,0,0,10" Checked="FoundationAnchor_Changed" Unchecked="FoundationAnchor_Changed"/>
                            <StackPanel Grid.Row="1" Margin="0,0,14,0">
                                <TextBlock Text="Tổng kích thước đoạn đứng + chân ngang (mm)" TextWrapping="Wrap"/>
                                <TextBox x:Name="FoundationLengthBox" Style="{StaticResource EditorText}" Width="150" HorizontalAlignment="Left" LostFocus="FoundationAnchor_Changed" IsEnabled="False"/>
                                <TextBlock Text="Cover móng tại đáy và bên (mm)" Margin="0,6,0,0"/>
                                <TextBox x:Name="FoundationCoverBox" Style="{StaticResource EditorText}" Width="150" HorizontalAlignment="Left" LostFocus="FoundationAnchor_Changed" IsEnabled="False"/>
                                <TextBlock Text="Hướng chân neo theo trục cột" Margin="0,6,0,0"/>
                                <ComboBox x:Name="FoundationDirectionBox" Style="{StaticResource EditorCombo}" IsEnabled="False" SelectionChanged="FoundationAnchor_Changed">
                                    <ComboBoxItem Content="Vào tâm — vuông góc từng cạnh"/>
                                    <ComboBoxItem Content="Ra ngoài — vuông góc từng cạnh"/>
                                    <ComboBoxItem Content="Cùng hướng +X cột"/><ComboBoxItem Content="Cùng hướng -X cột"/>
                                    <ComboBoxItem Content="Cùng hướng +Y cột"/><ComboBoxItem Content="Cùng hướng -Y cột"/>
                                </ComboBox>
                                <TextBlock Text="Số thanh lấy từ Cx/Cy. Bật Nhóm thép dọc ở tab Hình học để tạo Fixed Number; các thanh góc không lặp." TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <CheckBox x:Name="OpenAnchorModelCheck" IsChecked="True" IsEnabled="False" Margin="0,10,0,4" Content="Mở view 3D kiểm tra sau khi tạo"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock Text="Sơ đồ hướng chân neo (trục cột)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Border Background="#FFF4F7FA" BorderBrush="#FFD8DFEA" BorderThickness="1">
                                    <Canvas x:Name="FoundationCanvas" Height="240" ClipToBounds="True" SizeChanged="FoundationCanvas_SizeChanged"/>
                                </Border>
                                <TextBlock Text="Mũi tên là hướng chân L, không biểu diễn chiều dài. Trục cột xoay/mirror theo family trong mô hình." FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="FoundationAnchorSummary" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF315889"/>
                        </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#FF9C3D26"
                        Text="Chỉ dựng theo thiết kế đã duyệt; không tự tính neo/nối. Tổng kích thước nhập không phải chiều dài gia công sau uốn; lấy chiều dài thực từ Revit. Ghép cổ chai theo vị trí thực khi cùng số thanh; nối so le và tự bổ sung/kết thúc khi đổi số thanh chưa được hỗ trợ. Bản vẽ là DRAFT."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Thép đai">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20" Width="600" HorizontalAlignment="Left">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Hiệu chỉnh thép đai theo vùng" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Chiều dài vùng đai đầu cột mỗi đầu (mm)"/><TextBox x:Name="ZoneBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Bước đai hai đầu (mm)"/><TextBox x:Name="EndStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Bước đai giữa (mm)"/><TextBox x:Name="MidStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8"><TextBlock Width="285" VerticalAlignment="Center" Text="Quy tắc Rebar Set"/>
                        <ComboBox x:Name="TieLayoutBox" Width="230" Style="{StaticResource EditorCombo}" SelectionChanged="Edit_Changed">
                            <ComboBoxItem Content="Maximum Spacing"/><ComboBoxItem Content="Fixed Number"/>
                        </ComboBox></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Số đai vùng đầu (mỗi đầu)"/><TextBox x:Name="EndCountBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Width="285" VerticalAlignment="Center" Text="Số đai vùng giữa"/><TextBox x:Name="MidCountBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <CheckBox x:Name="CrossCheck" Margin="0,15,0,5" Content="Tạo đai phụ giữ các thanh giữa cạnh" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <CheckBox x:Name="CrossAlternateCheck" Margin="20,0,0,8" Content="Luân phiên đảo chiều móc đai phụ (90° - 135°)" Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <CheckBox x:Name="JointTiesCheck" Margin="0,8,0,5" Content="Đai nút phía trên đỉnh cột (trong đoạn thép chờ)" ToolTip="Chiều cao nút do người dùng nhập; không tự phát hiện dầm/sàn. Cần thép chờ đủ dài." Checked="Edit_Changed" Unchecked="Edit_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="20,2,0,4"><TextBlock Width="265" VerticalAlignment="Center" Text="Chiều cao nút dầm sàn (mm)"/><TextBox x:Name="JointHeightBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,2,0,8"><TextBlock Width="265" VerticalAlignment="Center" Text="Bước đai trong nút dầm (mm)"/><TextBox x:Name="JointStepBox" Width="120" Style="{StaticResource EditorText}" LostFocus="Text_LostFocus"/></StackPanel>
                    <TextBlock TextWrapping="Wrap" Foreground="#FF9C3D26" Margin="0,8,0,0" Text="Đai móc phải có Rebar Hook Type 135° và Rebar Shape phù hợp trong Project. Đai phụ có thể bị Revit từ chối nếu hình dạng không hợp lệ."/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Triển khai"><Grid x:Name="DeploymentHost" Background="White"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>

    <OutputType>WinExe</OutputType><TargetFramework>net48</TargetFramework><UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit 2024\</RevitInstallDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KStruct"><HintPath>../../bin/Release/KStruct.dll</HintPath></Reference>
    <Reference Include="RevitAPI"><HintPath>$(RevitInstallDir)RevitAPI.dll</HintPath></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitInstallDir)RevitAPIUI.dll</HintPath></Reference>
    <Compile Include="Program.cs.txt" />
  </ItemGroup>
</Project>

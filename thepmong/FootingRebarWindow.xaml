<Window x:Class="SDK_HD.KStruct.FootingRebar.FootingRebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KStruct - Cấu hình &amp; Bố trí thép móng đơn / móng cọc (TCVN 5574:2018 &amp; TCVN 198:1997)" 
        Height="750" Width="1080" WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BẢNG ĐIỀU CHỈNH THÔNG SỐ (BÊN TRÁI) -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,12,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- THÔNG TIN MÓNG & LOẠI MÓNG -->
                    <TextBlock Text="Thông tin cấu kiện móng" FontWeight="Bold" FontSize="14" Foreground="#212529"/>
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Dài X (mm)" FontSize="11" Foreground="#6C757D"/>
                            <TextBox x:Name="TxtLengthX" IsReadOnly="True" Background="#E9ECEF" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Rộng Y (mm)" FontSize="11" Foreground="#6C757D"/>
                            <TextBox x:Name="TxtWidthY" IsReadOnly="True" Background="#E9ECEF" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="2">
                            <TextBlock Text="Cao Z (mm)" FontSize="11" Foreground="#6C757D"/>
                            <TextBox x:Name="TxtHeight" IsReadOnly="True" Background="#E9ECEF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,2,0,6">
                        <TextBlock Text="Loại giải pháp móng:" FontSize="11" FontWeight="SemiBold" Foreground="#495057"/>
                        <ComboBox x:Name="CboFootingType" SelectionChanged="OnFootingTypeChanged" Height="26" Margin="0,2,0,0">
                            <ComboBoxItem Content="Móng đơn / Móng nông (Spread Footing)"/>
                            <ComboBoxItem Content="Móng cọc / Đài cọc (Pile Cap)"/>
                        </ComboBox>
                    </StackPanel>

                    <Separator Margin="0,6"/>

                    <!-- LỚP BẢO VỆ (COVER) THEO TCVN 5574:2018 -->
                    <TextBlock Text="Lớp bảo vệ bê tông (TCVN 5574:2018)" FontWeight="Bold" FontSize="13" Foreground="#212529"/>
                    <CheckBox x:Name="ChkHasLeanConcrete" Content="Có lớp bê tông lót (tự nhận diện / có thể chỉnh)" IsChecked="False"
                              Checked="OnLeanConcreteChanged" Unchecked="OnLeanConcreteChanged" Margin="0,4,0,2" FontWeight="SemiBold" Foreground="#0D6EFD"/>
                    <TextBlock Text="Tự nhận diện solid bê tông lót trong family (loại khỏi kích thước thân đài), lớp lót KStruct tạo hoặc Floor mỏng sát dưới đài. Kiểm tra và chỉnh checkbox nếu cấu tạo khác." TextWrapping="Wrap" FontSize="10" Foreground="#6C757D" Margin="2,0,2,5"/>
                    <Grid Margin="0,2,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Đáy (Bottom)" FontSize="11"/>
                            <TextBox x:Name="TxtCoverBottom" Text="70" TextChanged="OnParameterChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Cạnh (Side)" FontSize="11"/>
                            <TextBox x:Name="TxtCoverSide" Text="50" TextChanged="OnParameterChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="2">
                            <TextBlock Text="Đỉnh (Top)" FontSize="11"/>
                            <TextBox x:Name="TxtCoverTop" Text="50" TextChanged="OnParameterChanged"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <!-- THÉP ĐÁY PHƯƠNG X -->
                    <TextBlock Text="Thép đáy phương X (Bottom-X)" FontWeight="Bold" FontSize="13" Foreground="#0D6EFD"/>
                    <CheckBox x:Name="ChkEnableX" Content="Bố trí thép đáy X" IsChecked="True" Checked="OnParameterChanged" Unchecked="OnParameterChanged"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Đường kính (mm)" FontSize="11"/>
                            <ComboBox x:Name="CboDiameterX" SelectionChanged="OnParameterChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Khoảng cách a (mm)" FontSize="11"/>
                            <TextBox x:Name="TxtSpacingX" Text="150" TextChanged="OnParameterChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Kiểu bẻ móc neo X:" FontSize="11" Foreground="#495057"/>
                            <ComboBox x:Name="CboHookX" SelectionChanged="OnParameterChanged" Height="25">
                                <ComboBoxItem Content="Bẻ neo LÊN (90°)"/>
                                <ComboBoxItem Content="Bẻ neo XUỐNG (90°)"/>
                                <ComboBoxItem Content="Không bẻ móc (Thẳng)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Đoạn neo L (mm):" FontSize="11" Foreground="#495057"/>
                            <TextBox x:Name="TxtHookLengthX" Text="200" TextChanged="OnParameterChanged" Height="25"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <!-- THÉP ĐÁY PHƯƠNG Y -->
                    <TextBlock Text="Thép đáy phương Y (Bottom-Y)" FontWeight="Bold" FontSize="13" Foreground="#DC3545"/>
                    <CheckBox x:Name="ChkEnableY" Content="Bố trí thép đáy Y" IsChecked="True" Checked="OnParameterChanged" Unchecked="OnParameterChanged"/>
                    <Grid Margin="0,4,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Đường kính (mm)" FontSize="11"/>
                            <ComboBox x:Name="CboDiameterY" SelectionChanged="OnParameterChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Khoảng cách a (mm)" FontSize="11"/>
                            <TextBox x:Name="TxtSpacingY" Text="150" TextChanged="OnParameterChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="2">
                            <TextBlock Text="Kiểu bẻ móc neo Y:" FontSize="11" Foreground="#495057"/>
                            <ComboBox x:Name="CboHookY" SelectionChanged="OnParameterChanged" Height="25">
                                <ComboBoxItem Content="Bẻ neo LÊN (90°)"/>
                                <ComboBoxItem Content="Bẻ neo XUỐNG (90°)"/>
                                <ComboBoxItem Content="Không bẻ móc (Thẳng)"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="2">
                            <TextBlock Text="Đoạn neo L (mm):" FontSize="11" Foreground="#495057"/>
                            <TextBox x:Name="TxtHookLengthY" Text="200" TextChanged="OnParameterChanged" Height="25"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,6"/>

                    <!-- THÉP LỚP TRÊN (TOP REBAR) -->
                    <Expander Header="Thép lớp trên (TCVN 10304 / TCVN 198)" IsExpanded="False" x:Name="ExpanderTop" FontWeight="Bold" Foreground="#FD7E14" Margin="0,2,0,4">
                        <StackPanel Margin="6,4,0,0">
                            <CheckBox x:Name="ChkEnableTop" Content="Bật lưới thép lớp trên (Top Rebar)" IsChecked="False" Checked="OnParameterChanged" Unchecked="OnParameterChanged" Margin="0,2,0,4"/>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="2">
                                    <TextBlock Text="Đường kính Top (mm)" FontSize="11"/>
                                    <ComboBox x:Name="CboDiameterTop" SelectionChanged="OnParameterChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2">
                                    <TextBlock Text="Khoảng cách a (mm)" FontSize="11"/>
                                    <TextBox x:Name="TxtSpacingTop" Text="200" TextChanged="OnParameterChanged"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="2">
                                    <TextBlock Text="Kiểu bẻ móc neo Top:" FontSize="11" Foreground="#495057"/>
                                    <ComboBox x:Name="CboTopHook" SelectionChanged="OnParameterChanged" Height="25">
                                        <ComboBoxItem Content="Bẻ neo XUỐNG (90°)"/>
                                        <ComboBoxItem Content="Bẻ neo LÊN (90°)"/>
                                        <ComboBoxItem Content="Không bẻ móc (Thẳng)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2">
                                    <TextBlock Text="Đoạn neo L (mm):" FontSize="11" Foreground="#495057"/>
                                    <TextBox x:Name="TxtTopHookLength" Text="200" TextChanged="OnParameterChanged" Height="25"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Separator Margin="0,6"/>

                    <!-- THÉP ĐAI CẤU TẠO HÔNG (SIDE TIES KHI H > 700 MM) -->
                    <Expander Header="Thép đai cấu tạo hông (TCVN 198:1997 khi H > 700mm)" IsExpanded="False" x:Name="ExpanderSideTies" FontWeight="Bold" Foreground="#6F42C1" Margin="0,2,0,6">
                        <StackPanel Margin="6,4,0,0">
                            <CheckBox x:Name="ChkEnableSideTies" Content="Bố trí đai cấu tạo hông chu vi" IsChecked="False" Checked="OnParameterChanged" Unchecked="OnParameterChanged" Margin="0,2,0,4"/>
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="2">
                                    <TextBlock Text="Đường kính đai (mm)" FontSize="11"/>
                                    <ComboBox x:Name="CboDiameterTie" SelectionChanged="OnParameterChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="2">
                                    <TextBlock Text="Khoảng cách đai (mm)" FontSize="11"/>
                                    <TextBox x:Name="TxtSpacingTie" Text="200" TextChanged="OnParameterChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Button Content="Tạo bố trí thép theo TCVN" Click="OnBtnAcceptClick" Height="40" Background="#0D6EFD" Foreground="White" FontWeight="Bold" FontSize="13" Cursor="Hand" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MINH HỌA HÌNH HỌC TƯƠNG TÁC (BÊN PHẢI) -->
        <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="6" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,4,0,6">
                    <TextBlock Text="Minh họa mặt cắt móng &amp; bố trí cốt thép theo TCVN" FontWeight="Bold" FontSize="13" Foreground="#495057" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TxtPreviewInfo" Text="Mặt cắt dọc thể hiện cốt thép đáy, thép trên và đai cấu tạo" FontSize="11" Foreground="#6C757D" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <Viewbox Grid.Row="1" Stretch="Uniform">
                    <Canvas x:Name="PreviewCanvas" Width="640" Height="420" Background="#FAFAFA"/>
                </Viewbox>

                <!-- CHÚ THÍCH CỐT THÉP -->
                <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,8,0,4">
                    <StackPanel Orientation="Horizontal" Margin="8,2">
                        <Rectangle Width="14" Height="10" Fill="#0D6EFD" Margin="0,0,4,0"/>
                        <TextBlock Text="Thép đáy X (Lớp dưới)" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,2">
                        <Ellipse Width="10" Height="10" Fill="#DC3545" Margin="0,0,4,0"/>
                        <TextBlock Text="Thép đáy Y (Lớp trên)" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,2">
                        <Rectangle Width="14" Height="10" Fill="#FD7E14" Margin="0,0,4,0"/>
                        <TextBlock Text="Thép đỉnh (Top Rebar)" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,2">
                        <Rectangle Width="14" Height="4" Fill="#6F42C1" Margin="0,0,4,0"/>
                        <TextBlock Text="Đai hông (TCVN 198)" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,2">
                        <Rectangle Width="14" Height="6" Fill="#FFC107" Margin="0,0,4,0"/>
                        <TextBlock Text="Bê tông lót (minh họa 100 mm)" FontSize="11"/>
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
